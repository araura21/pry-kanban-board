      "html": "<section class=\"ds-column\"><header class=\"ds-column-head\"><h2 class=\"ds-column-title\">Creado</h2><span class=\"ds-count\" aria-label=\"Cantidad de tareas\">0</span></header><p class=\"ds-empty\">Las nuevas ideas empiezan aquí.</p></section>",
